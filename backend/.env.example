# ==========================================
# RenewalOS Environment Configuration
# ==========================================

# 1. Database Connection
DATABASE_URL=sqlite:///./renewalos.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/renewalos

# 2. Authentication & Application URL
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 3. Hindsight Memory Service (Vectorize.io)
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_BANK_ID=renewal_os_bank

# 4. LLM Engine (Groq Llama 3.3 70B Versatile)
GROQ_API_KEY=
