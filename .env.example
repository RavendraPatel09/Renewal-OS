# ==========================================
# RenewalOS Production Environment Configuration
# ==========================================

# 1. Database & Persistence
# Target SQLite for local development or managed PostgreSQL for production.
# Example: postgresql://postgres:password@localhost:5432/renewalos
DATABASE_URL=sqlite:///./renewalos.db

# 2. Authentication & Security
# Cryptographic secret key used to sign and verify PyJWT access tokens.
JWT_SECRET=super_secret_jwt_key_renewal_os_production_2026

# 3. Application URLs & CORS
# Base frontend URL used for redirects and canonical links.
APP_URL=http://localhost:5173

# Comma-separated allowed CORS origin origins for FastAPI backend.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 4. Hindsight Memory Engine (Vectorize.io)
# Hindsight API key obtained from Vectorize.io dashboard. Optional if using local server.
HINDSIGHT_API_KEY=

# Base endpoint of Hindsight Memory Service (default: http://localhost:8888 or cloud endpoint).
HINDSIGHT_BASE_URL=http://localhost:8888

# Persistent Memory Bank Identifier.
HINDSIGHT_BANK_ID=renewal_os_bank

# 5. LLM Inference Engine (Groq)
# Groq API Key for llama-3.3-70b-versatile high-throughput JSON reasoning.
# If omitted, RenewalOS automatically falls back to its deterministic rule-based reflection engine.
GROQ_API_KEY=

# 6. Frontend Environment Configuration
# Backend API Base URL consumed by Vite React frontend.
VITE_API_URL=http://localhost:8000
